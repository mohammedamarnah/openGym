":[{"lo":8,"hi":10,"rpe":10},{"lo":12,"hi":15,"rpe":9}],"note":"Top set to failure. Drop weight for back-off."},{"n":"Pullover (Dumbbell)","sets":[{"lo":10,"hi":12,"rpe":9,"x":2}],"note":"Classic Mentzer torso expander. Stop 1 rep short of failure."},{"n":"Face Pull","sets":[{"r":15,"x":2}],"note":"Huberman posture baseline. Hold contraction at bridge of nose."},{"n":"Neck Curl","sets":[{"lo":12,"hi":15,"x":2}]},{"n":"Neck Flexion","sets":[{"lo":12,"hi":15,"x":2}]},{"n":"Neck Extension","sets":[{"lo":12,"hi":15,"x":2}]}]},{"ex":[{"n":"Cardio","sets":[{"sec":1200,"secHi":1800,"pct":75}],"note":"jogging, stairs, rowing, cycling"}]},{"ex":[{"n":"Overhead Press (Barbell)","sets":[{"lo":5,"hi":7,"rpe":9},{"lo":8,"hi":10,"rpe":8}],"note":"Top set to failure. Drop weight 15% for back-off."},{"n":"Lateral Raise (Machine)","sets":[{"lo":10,"hi":12,"rpe":10},{"lo":12,"hi":15,"rpe":9}],"note":"Constant profile machine tension. Drop weight for back-off."},{"n":"Bicep Curl (Barbell)","sets":[{"lo":6,"hi":8,"rpe":10},{"lo":12,"hi":15,"rpe":9}],"note":"Top set to absolute failure. Drop weight for back-off."},{"n":"Hammer Curl (Dumbbell)","sets":[{"lo":10,"hi":12,"rpe":9,"x":2}],"note":"Hit the brachialis and forearms heavily."},{"n":"Overhead Tricep Extension (Cable)","sets":[{"lo":8,"hi":10,"rpe":10},{"lo":12,"hi":15,"rpe":9}],"note":"Run as mechanical drop-set on failure. Drop weight for back-off."},{"n":"Tricep Kickback","sets":[{"lo":8,"hi":10,"rpe":10},{"lo":12,"hi":15,"rpe":9}]},{"n":"Cable Crunch","sets":[{"lo":10,"hi":15,"x":3}],"note":"Track weight stack. Flex spine, pull elbows to knees."}]},{"ex":[{"n":"Assault Bike","sets":[{"rpe":10,"x":8}]}]}],[null,null,null,null,null,null],[null,null,null,null,null,null],[null,null,null,null,null,null],[null,null,null,null,null,null],[null,null,null,null,null,null],[null,null,null,null,null,null],[null,null,null,null,null,null]]}]}
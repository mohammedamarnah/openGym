{"id":"u-820d951b-4f1a-4b9b-9af7-91ccc0f9acf7","src":"community","title":"Volleyball Strength Training","author":"","url":"https://www.boostcamp.app/users/BJtPbJ-volleyball-strength-training","desc":"Get into peak performance as an adult playing competitive volleyball. This is meant for working adults who don't have time to workout everyday of the week. This is a three day split-- upper, lower, and power training-- so that you have time to play volleyball on the off days. the upper and lower days will have two compound workouts (bench/shoulder press, or squat deadlifts) plus accessory workouts. The third day is meant to train explosiveness, plyometrics, and core, which includes ladders, med-ball slams, and box jumps.\n\nPlease note that I am not a professional, I'm just a 25y/o woman that plays a ton of volleyball!","level":["Intermediate"],"goals":["Athletics"],"equipment":["Full Gym"],"minutes":60,"joins":0,"rate":0,"rateCount":0,"updated":"2026-08-11T14:58:12.899Z","variations":[{"name":"default","days":["Lower Body Strength & Power","Upper Body","Explosiveness, Plyos & Core"],"weeks":[[{"ex":[{"n":"Squat (Barbell)","sets":[{"r":6,"x":4}]},{"n":"Romanian Deadlift (Dumbbell)","sets":[{"r":6,"x":4}]},{"n":"Bulgarian Split Squat (Dumbbell)","sets":[{"r":8,"x":3}]},{"n":"Hip Thrust (Machine)","sets":[{"r":8,"x":3}]},{"n":"Step-Up (Weighted)","sets":[{"r":6,"x":3}]},{"n":"Glute Med Kickback","sets":[{"r":6,"x":3}]},{"n":"Standing Calf Raise","sets":[{"r":10,"x":3}]}]},{"ex":[{"n":"Bench Press (Dumbbell)","sets":[{"r":6,"x":4}]},{"n":"Seated Shoulder Press (Dumbbell)","sets":[{"r":6,"x":4}]},{"n":"Pull-Up (Assisted)","sets":[{"r":6,"x":3}]},{"n":"Upright Row (Barbell)","sets":[{"r":6,"x":3}]},{"ss":[{"n":"Seated Cable Row (Close Grip)","sets":[{"r":6,"x":2}]},{"n":"Face Pull","sets":[{"r":8,"x":2}]}]},{"ss":[{"n":"Lateral Raise (Dumbbell)","sets":[{"r":8,"x":2}]},{"n":"Front Raise","sets":[{"r":8,"x":2}]}]}]},{"ex":[{"n":"Hang Clean","sets":[{"r":6,"x":3}]},{"n":"Later
{"id":"u-72f3c6cf-4741-460f-ab7f-9204d868fba1","src":"community","title":"Coach Coolege Beginner PHUL","author":"Justin Parkin","url":"https://www.boostcamp.app/users/xf20pY-coach-coolege-beginner-phul","desc":"I wanted something usable for beginners, but the availability of mobility exercises on boostcamp leaves a lot to be desired.  Apply progressive overload.  This is a good beginner program to avoid burnout while seeing results.  Repeat weekly.","level":["Beginner","Intermediate"],"goals":["Athletics","Muscle","Strength"],"equipment":["Garage Gym"],"minutes":90,"joins":4,"rate":0,"rateCount":0,"updated":"2026-07-07T07:32:40.121Z","variations":[{"name":"default","days":["Power Upper","Power Lower","Hypertrophy Upper","Hypertrophy Lower"],"weeks":[[{"ex":[{"n":"Bench Press (Barbell)","sets":[{"r":10,"rpe":6},{"r":6,"rpe":7.5},{"r":6,"rpe":8},{"r":4,"rpe":9}],"note":"Apply double progression"},{"n":"Pendlay Row","sets":[{"r":12,"rpe":6},{"r":10,"rpe":7},{"r":10,"rpe":7.5},{"r":10,"rpe":8.5}]},{"n":"Overhead Press (Barbell)","sets":[{"r":10,"rpe":6},{"r":8,"rpe":7},{"r":8,"rpe":8},{"r":5,"rpe":8.5}]},{"n":"Pull-Up (Weighted)","sets":[{"r":10,"rpe":6},{"r":8,"rpe":7},{"r":6,"rpe":8},{"r":5,"rpe":9}],"note":"Bodyweight, weighted, or lat pulldown depending on preference and ability."}]},{"ex":[{"n":"Squat (Barbell)","sets":[{"r":5,"rpe":8},{"r":5,"rpe":8.5,"x":2},{"r":5,"rpe":9}],"note":"Apply double progression"},{"n":"Romanian Deadlift (Barbell)","sets":[{"r":5,"rpe":7},{"r":5,"rpe":8},{"r":5,"rpe":8.5},{"r":5,"rpe":9}],"note":"Or conventional deadlifts.   If doing Romanian deadlifts, consider eccentric loading focus every other week."},{"n":"Single Leg Calf Raise (Weighted)","sets":[{"r":10,"rpe":7,"x":2},{"r":10,"rpe":8,"x":2}],"note":"Focus on eccentric loading such as a 4 2 1 count.  Apply progressive overload."}]},{"ex":[{"n":"Incline Bench Press (Barbell)","sets":[{"r":12,"rpe":7},{"r":12,"rpe":7.5},{"r":12,"rpe":8}],"note":"8-12, apply double progression to everything below."},{"n":"Chest Fly (Dumbbell)","sets":[{"r":12,"rpe":6.5},{"r":12,"rpe":7,"x":2}]},{"n":"Dumbbell Row","sets":[{"r":12,"rpe":6.5},{"r":12,"rpe":7},{"r":12,"rpe":7.5}]},{"n":"Lateral Raise (Dumbbell)","sets":[{"r":12,"rpe":6.5},{"r":12,"rpe":7,"x":2}]},{"n":"Bicep Curl (EZ Bar)","sets":[{"r":12,"rpe":6.5},{"r":12,"rpe":7},{"r":12,"rpe":7.5}],"note":"This can be any curls, pick your favorite."},{"n":"Tricep Pushdown (Cable)","sets":[{"r":12,"rpe":6.5},{"r":12,"rpe":7},{"r":12,"rpe":8}],"note":"Or Skullcrushers"}]},{"ex":[{"n":"Bulgarian Split Squat (Dumbbell)","sets":[{"r":12,"rpe":6.5},{"r":12,"rpe":7},{"r":12,"rpe":8}],"note":"Or your favorite single leg squats"},{"n":"Single Leg Romanian Deadlift","sets":[{"r":12,"rpe":6.5},{"r":12,"rpe":7.5},{"r":12,"rpe":8}]},{"n":"Cossack Squat","sets":[{"r":12,"rpe":6.5},{"r":12,"rpe":7,"x":2}]},{"n":"Tibia Pull","sets":[{"r":15,"rpe":7},{"r":15,"rpe":7.5,"x":2}]},{"n":"Seated Calf Raise","sets":[{"r":12,"rpe":7,"x":2},{"r":12,"rpe":8}],"note":"Or other favorite calf exercise."},{"n":"Plank","sets":[{"sec":0,"rpe":8.5}]},{"n":"Side Plank","sets":[{"sec":0,"rpe":8.5}],"note":"Or russian twists"}]}]]}]}
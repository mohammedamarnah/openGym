{"id":"u-02aee58b-b2ca-4507-8c26-9468d1b2be7d","src":"community","title":"Big Booty Boulder Shoulders","author":"Al P.","url":"https://www.boostcamp.app/users/LUNs7S-big-booty-boulder-shoulders","desc":"Start your week with a full body kettlebell circuit to prime your core for a week of work. Moving into the week, get into a moderate intensity, endurance building leg workout. Enjoy the suck of split squats to round your rear. Midweek we move to an arm and back blast. Finish strong with a heavy leg day to have you hobbling into your weekend.","level":["Intermediate","Beginner"],"goals":["Women's","Muscle","Strength"],"equipment":["Full Gym"],"minutes":60,"joins":10,"rate":0,"rateCount":0,"updated":"2026-10-29T21:48:24.320Z","variations":[{"name":"default","days":["Core Conditioning","Leg Blast","Boulder Shoulders","Booty Blastoff"],"weeks":[[{"ex":[{"n":"Turkish Get Up","sets":[{"lo":3,"hi":5,"rpe":8,"x":3}],"note":"Reps are for each arm, not total!"},{"n":"Kettlebell Swing","sets":[{"lo":10,"hi":15,"rpe":9,"x":3}]},{"n":"B-Stance Romanian Deadlift (Dumbbell)","sets":[{"r":8,"rpe":8,"x":3}],"note":"8 each leg"},{"n":"Dead Bug","sets":[{"r":20,"rpe":8,"x":3}],"note":"For an extra challenge hold a weight over your chest in a static arm position, alternate your legs"},{"n":"Russian Twist (Dumbbell)","sets":[{"r":20,"rpe":8,"x":3}],"note":"Count left as one, right as 2 etc until 20"},{"n":"Reaching Situp","sets":[{"r":10,"rpe":8,"x":3}],"note":"Weighted!"},{"n":"Kettlebell Halo","sets":[{"r":10,"rpe":8,"x":3}],"note":"5 each side, for an extra glute bonus you can do them kneeling with a hip drive into extension while completing the halo"},{"n":"Plank Pull Through","sets":[{"r":20,"rpe":8,"x":3}],"note":"Do a plank with a heavy weight starting on one side. Pull the weight underneath you to the other side. One direction equals 1 rep."}]},{"ex":[{"n":"Squat (Barbell)","sets":[{"r":8,"rpe":6},{"r":6},{"r":6,"rpe":8.5,"x":2}]},{"n":"Split Squat (Smith Machine)","sets":[{"r":8
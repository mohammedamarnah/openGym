{"id":"u-717a8385-c318-4936-b2ce-8121175b1a5e","src":"community","title":"gym program 🏋️‍♀️","author":"karolina diamantopoulos","url":"https://www.boostcamp.app/users/BvcLvJ-push-and-pull","desc":"starting point for strength and confidence. step-by-step to feel comfortable and capable in the gym.","level":["Beginner","Intermediate"],"goals":["Muscle","Strength"],"equipment":["Full Gym"],"minutes":60,"joins":1,"rate":0,"rateCount":0,"updated":"2026-05-13T00:41:42.101Z","variations":[{"name":"default","days":["CHEST, SHOULDERS & TRIS","QUADS & GLUTES","ABS & CARDIO","BACK & BI","HAMSTRINGS & CALVES"],"weeks":[[{"ex":[{"n":"Chest Press (Machine)","sets":[{"lo":8,"hi":10,"rpe":7},{"lo":8,"hi":10,"rpe":8},{"lo":8,"hi":10,"rpe":9}]},{"n":"Overhead Press (Barbell)","sets":[{"lo":8,"hi":10,"rpe":7},{"lo":8,"hi":10,"rpe":8},{"lo":8,"hi":10,"rpe":9}]},{"n":"Chest Fly (Machine)","sets":[{"lo":10,"hi":12,"rpe":7},{"lo":10,"hi":12,"rpe":8},{"lo":10,"hi":12,"rpe":9}],"note":"stand to feel more"},{"n":"Lateral Raise (Cable)","sets":[{"r":10,"rpe":8,"x":3}]},{"n":"Overhead Tricep Extension (Cable)","sets":[{"r":10,"rpe":8,"x":3}],"note":"big stretch at the bottom"},{"n":"Tricep Rope Push Down (Cable)","sets":[{"r":10,"rpe":8,"x":3}]}]},{"ex":[{"n":"Squat (Barbell)","sets":[{"r":10,"rpe":7},{"r":10,"rpe":8},{"r":10,"rpe":9}],"note":"heels elevated = more quad focus\nheels flat = more glute focus"},{"n":"Leg Press","sets":[{"r":10,"rpe":8,"x":2}],"note":"feet mid–low → more quad dominant"},{"n":"Single Leg Press","sets":[{"r":10,"rpe":8,"x":2}],"note":"feet slightly higher → more glutes"},{"n":"Leg Extension","sets":[{"r":10,"rpe":9,"x":3}]},{"ss":[{"n":"Hip Adductor (Machine)","sets":[{"r":10,"rpe":8,"x":3}],"note":"lean back = more inner thigh"},{"n":"Hip Abductor (Machine)","sets":[{"r":10,"rpe":8,"x":3}],"note":"lean forward = more glute focus\nlean back = more hip focus"}]}]},{"ex":[{"n":"Plank","sets":[{"sec":60,"rpe":7},{"sec":60,"rpe":8}],"note":"ribs down, glutes tight, back straight"},{"n":"Side Plank","sets":[{"sec":30,"rpe":7},{"sec":30,"rpe":8}],"note":"progression - lift top leg"},{"n":"Ab Wheel","sets":[{"r":10,"rpe":7},{"r":10,"rpe":8}],"note":"don’t arch lower back, push to where is comfortable and build on that"},{"n":"Russian Twist (Dumbbell)","sets":[{"sec":60,"rpe":7},{"sec":60,"rpe":8}],"note":"control rotation, don’t rush"},{"n":"Abs Crunch (Weighted)","sets":[{"r":20,"rpe":7},{"r":20,"rpe":8}]},{"n":"Oblique Crunch","sets":[{"sec":60,"rpe":7},{"sec":60,"rpe":8}]},{"n":"Lying Leg Raise","sets":[{"r":20,"rpe":7},{"r":20,"rpe":8}],"note":"don’t swing legs, elevate and lower in a controlled manner"},{"n":"Dead Bug","sets":[{"r":20,"rpe":7},{"r":20,"rpe":8}]},{"n":"Sit Up","sets":[{"r":10,"rpe":7},{"r":10,"rpe":8}]},{"n":"Treadmill","sets":[{"sec":600,"secHi":1200,"rpe":6}],"note":"speed: 4-6km\nincline: 8-15"}]},{"ex":[{"n":"Lat Pulldown","sets":[{"r":10,"rpe":9,"x":3}]},{"n":"Dumbbell Row","sets":[{"r":10,"rpe":7},{"r":10,"rpe":8},{"r":10,"rpe":9}],"note":"pull elbow towards hip (not chest) for more lat"},{"n":"Back Extension (Weighted)","sets":[{"r":10,"rpe":7},{"r":10,"rpe":8},{"r":10,"rpe":9}]},{"n":"Bicep Curl (Machine)","sets":[{"r":10,"rpe":7},{"r":10,"rpe":8},{"r":10,"rpe":9}],"note":"full stretch at bottom (DO NOT FULLY EXTEND)"}]},{"ex":[{"n":"Romanian Deadlift (Barbell)","sets":[{"r":10,"rpe":7},{"r":10,"rpe":8},{"r":10,"rpe":9}]},{"n":"Glute-Ham Raise","sets":[{"lo":8,"hi":10,"rpe":8,"x":3}],"note":"controlled, don’t rush reps"},{"n":"Leg Curl","sets":[{"r":10,"rpe":8,"x":3}]},{"n":"Seated Calf Raise","sets":[{"r":10,"rpe":8,"x":3}]}]}]]}]}